# Optional. fob-actual reads profiles from ~/.fob/fob-actual/config.yml (see `fob-actual config profiles add`).
# For workers and CI, set these instead. Server URL and session token are both required for env mode.
# FOB_ACTUAL_SERVER_URL=https://budget.example.com
# FOB_ACTUAL_SESSION_TOKEN=
# FOB_ACTUAL_SYNC_ID=
# FOB_ACTUAL_ENCRYPTION_PASSWORD=
# FOB_ACTUAL_DATA_DIR=

# Optional. Use a different config directory (default ~/.fob/fob-actual).
# FOB_ACTUAL_CONFIG_DIR=
