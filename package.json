{
  "name": "@finopsbricks/fob-actual",
  "version": "0.1.0",
  "description": "Actual Budget CLI and Node.js client: accounts, transactions, budgets, rules and ActualQL from the terminal, an AI agent or your code.",
  "homepage": "https://finopsbricks.com/cli/fob-actual",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fob-actual": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:watch": "tsc -p jsconfig.json --watch"
  },
  "keywords": [
    "actual",
    "actual-budget",
    "budgeting",
    "personal-finance",
    "cli",
    "finops",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finopsbricks/fob-actual.git"
  },
  "bugs": {
    "url": "https://github.com/finopsbricks/fob-actual/issues"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@actual-app/api": "26.9.0",
    "@inquirer/prompts": "^7.10.1",
    "js-yaml": "^4.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
